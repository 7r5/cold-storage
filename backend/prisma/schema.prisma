// Prisma schema for Cold Chain Control
// Run: npx prisma db push  (pushes schema to DB without migrations)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// App user (dummy auth, plain password — POC only)
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      Role     @default(USER)
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  phone     String?
  age       Int?
  position  String?  // job title / position
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

enum Role {
  USER
  ROOT
}

// A refrigerated truck
model Truck {
  id         Int          @id @default(autoincrement())
  plate      String       @unique
  model      String
  driverName String       @map("driver_name")
  driverId   Int?         @map("driver_id")
  status     TruckStatus  @default(IDLE)
  createdAt  DateTime     @default(now()) @map("created_at")

  driver    Driver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  boxes     Box[]
  routes    Route[]
  positions Position[]

  @@map("trucks")
}

enum TruckStatus {
  IDLE
  ON_ROUTE
  MAINTENANCE
}

// A refrigerated box mounted on a truck
model Box {
  id              Int    @id @default(autoincrement())
  code            String @unique
  truckId         Int    @map("truck_id")
  // Acceptable ranges; outside these = alert
  targetTempMin   Float  @map("target_temp_min")
  targetTempMax   Float  @map("target_temp_max")
  targetHumMin    Float  @map("target_hum_min")
  targetHumMax    Float  @map("target_hum_max")

  truck    Truck     @relation(fields: [truckId], references: [id], onDelete: Cascade)
  readings Reading[]
  alerts   Alert[]
  loads    BoxLoad[]

  @@map("boxes")
}

// A planned/active route for a truck
model Route {
  id              Int          @id @default(autoincrement())
  truckId         Int          @map("truck_id")
  originName      String       @map("origin_name")
  destinationName String       @map("destination_name")
  // Optional FKs to Branch — null when branch is not yet registered
  originBranchId      Int?     @map("origin_branch_id")
  destinationBranchId Int?     @map("destination_branch_id")
  status          RouteStatus  @default(PENDING)
  // Array of [lng, lat] coordinates (waypoints to interpolate)
  waypoints       Json
  startedAt       DateTime?    @map("started_at")
  finishedAt      DateTime?    @map("finished_at")

  truck              Truck     @relation(fields: [truckId], references: [id], onDelete: Cascade)
  originBranch       Branch?   @relation("RouteOrigin", fields: [originBranchId], references: [id])
  destinationBranch  Branch?   @relation("RouteDestination", fields: [destinationBranchId], references: [id])
  loads              BoxLoad[]
  readings           Reading[]
  positions          Position[]

  @@map("routes")
}

enum RouteStatus {
  PENDING
  ACTIVE
  COMPLETED
}

// GPS tracking points (history of where the truck has been)
model Position {
  id         Int      @id @default(autoincrement())
  truckId    Int      @map("truck_id")
  routeId    Int?     @map("route_id")
  lat        Float
  lng        Float
  recordedAt DateTime @default(now()) @map("recorded_at")

  truck Truck  @relation(fields: [truckId], references: [id], onDelete: Cascade)
  route Route? @relation(fields: [routeId], references: [id], onDelete: SetNull)

  @@index([truckId, recordedAt])
  @@index([routeId])
  @@map("positions")
}

// Sensor reading from a box, optionally linked to the active route at record time
model Reading {
  id          Int      @id @default(autoincrement())
  boxId       Int      @map("box_id")
  routeId     Int?     @map("route_id")
  temperature Float
  humidity    Float
  recordedAt  DateTime @default(now()) @map("recorded_at")

  box   Box    @relation(fields: [boxId], references: [id], onDelete: Cascade)
  route Route? @relation(fields: [routeId], references: [id], onDelete: SetNull)

  @@index([boxId, recordedAt])
  @@index([routeId])
  @@map("readings")
}

// A physical branch: warehouse, pharmacy, hospital, or distribution center.
// Linked optionally to Route as origin/destination.
model Branch {
  id      Int        @id @default(autoincrement())
  name    String
  address String?
  city    String
  type    BranchType @default(WAREHOUSE)

  originRoutes      Route[] @relation("RouteOrigin")
  destinationRoutes Route[] @relation("RouteDestination")

  @@map("branches")
}

enum BranchType {
  WAREHOUSE
  PHARMACY
  HOSPITAL
  DISTRIBUTION_CENTER
}

// A pharmaceutical product that can be loaded into boxes.
// Temperature/humidity alert thresholds remain on Box (physical container).
model Product {
  id          Int     @id @default(autoincrement())
  sku         String  @unique
  name        String
  description String?
  category    String?

  loads BoxLoad[]

  @@map("products")
}

// The load assigned to a specific box for a specific route.
// Records what pharmaceutical product is in each box during a trip.
model BoxLoad {
  id        Int    @id @default(autoincrement())
  boxId     Int    @map("box_id")
  productId Int    @map("product_id")
  routeId   Int    @map("route_id")
  quantity  Float
  unit      String @default("units")

  box     Box     @relation(fields: [boxId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  route   Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([boxId, productId, routeId])
  @@map("box_loads")
}

// Alert raised when a reading is out of range
model Alert {
  id           Int           @id @default(autoincrement())
  boxId        Int           @map("box_id")
  type         AlertType
  severity     AlertSeverity @default(WARNING)
  message      String
  acknowledged Boolean       @default(false)
  recordedAt   DateTime      @default(now()) @map("recorded_at")

  box Box @relation(fields: [boxId], references: [id], onDelete: Cascade)

  @@map("alerts")
}

enum AlertType {
  TEMP
  HUM
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

// Bug report submitted by any user from within the app
model Bug {
  id         Int       @id @default(autoincrement())
  title      String
  location   String
  expected   String    @db.Text
  actual     String    @db.Text
  status     BugStatus @default(OPEN)
  reportedBy String?   @map("reported_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("bugs")
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

// Professional driver assigned to a truck
model Driver {
  id            Int      @id @default(autoincrement())
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  licenseNumber String   @unique @map("license_number")
  phone         String?
  createdAt     DateTime @default(now()) @map("created_at")

  trucks Truck[]

  @@map("drivers")
}

// FAQ entry displayed in the Ayuda (Help) page
model Faq {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String   @db.Text
  category  String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("faqs")
}
